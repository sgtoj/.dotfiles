{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "title": {
      "model": "opencode/claude-sonnet-5"
    }
  },
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
        "disabled": false
      }
    }
  },
  "formatter": {
    "markdown": {
      "command": ["mdformat", "$FILE"],
      "extensions": [".md"]
    },
    "terraform": {
      "command": ["tofu", "fmt", "$FILE"],
      "extensions": [".tf"]
    }
  },
  "lsp": {
    "terraform": {
      "command": ["tofu-ls", "serve"],
      "extensions": [".terraform", ".tf"]
    }
  }
}
