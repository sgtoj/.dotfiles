#!/usr/bin/env python3

import fcntl
import os
import subprocess
import sys
import time
from pathlib import Path

CACHE_HOME = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
LOCK = CACHE_HOME / "tsh-mcp-login.lock"
# tsh waits up to 180 seconds for a browser login before giving up.
COOLDOWN = 300


def logged_in():
    status = subprocess.run(
        ["tsh", "status"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return status.returncode == 0


def last_attempt(lock):
    lock.seek(0)
    try:
        return float(lock.read().strip() or 0)
    except ValueError:
        return 0


def main():
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    # MCP clients start one server per workspace and restart them together, so
    # every copy queues here and an expired session opens one browser login.
    with open(LOCK, "a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not logged_in():
            if time.time() - last_attempt(lock) < COOLDOWN:
                sys.exit("tsh-mcp: a Teleport login just failed; run `tsh login`, then reconnect")
            lock.truncate(0)
            lock.write(str(time.time()))
            lock.flush()
            # stdout carries the MCP protocol, so login output goes to stderr.
            # If the client kills this process while the browser login is
            # pending, the login lives on in its own session and keeps the lock.
            subprocess.run(
                ["tsh", "login"],
                stdin=subprocess.DEVNULL,
                stdout=sys.stderr,
                pass_fds=(lock.fileno(),),
                start_new_session=True,
            )
            # Exiting here stops tsh from opening its own browser login.
            if not logged_in():
                sys.exit("tsh-mcp: Teleport login did not complete")
    os.execvp("tsh", ["tsh", "mcp", *sys.argv[1:]])


if __name__ == "__main__":
    main()
