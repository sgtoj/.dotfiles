#!/usr/bin/env bash
#
# oc-notify -- surface opencode panes that need attention, across every tmux session.
#
# Driven by ~/.config/opencode/plugin/tmux-notify.ts. Everything renders inside tmux;
# there are no desktop notifications. State lives in tmux user options so the status bar
# is event-driven and needs no polling:
#
#   @oc_state  pane-scoped, the source of truth (waiting|done|error)
#   @oc_win    window-scoped, highest severity in that window (drives the window marker)
#   @oc_alert  global, pre-rendered badges, empty when nothing is waiting
#
# @oc_alert is the first element of status-right. status-right is right-aligned, so it
# grows leftward into unused space and the existing right-hand widgets never move.
#
# @oc_state is deliberately never set at window/session/global scope. tmux option lookup
# falls back pane -> window -> session -> global, so reusing one name would make unflagged
# panes inherit their window's flag and corrupt every count.
#
# Usage:
#   oc-notify set <pane> <waiting|done|error> <label> [detail]
#   oc-notify clear <pane>
#   oc-notify jump                 # focus the most urgent flagged pane
#   oc-notify jump-to <pane>       # focus one pane
#   oc-notify refresh              # rebuild the status bar, drop stale flags

set -uo pipefail

PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
export PATH

OPT="@oc_state"
WOPT="@oc_win"
ALERT_OPT="@oc_alert"
SOUND_DIR="/System/Library/Sounds"

TMUX_BIN="$(command -v tmux 2>/dev/null || true)"
[ -n "$TMUX_BIN" ] || TMUX_BIN="/opt/homebrew/bin/tmux"
[ -x "$TMUX_BIN" ] || exit 0

die() {
  printf 'oc-notify: %s\n' "$1" >&2
  exit 2
}

rank_for() {
  case "${1:-}" in
    waiting) printf '3' ;;
    error) printf '2' ;;
    done) printf '1' ;;
    *) printf '0' ;;
  esac
}

colour_for() {
  case "${1:-}" in
    waiting) printf '#{@thm_red}' ;;
    error) printf '#{@thm_peach}' ;;
    *) printf '#{@thm_yellow}' ;;
  esac
}

sound_for() {
  case "${1:-}" in
    waiting) printf 'Funk' ;;
    error) printf 'Basso' ;;
    *) printf 'Tink' ;;
  esac
}

play() {
  local file
  file="$SOUND_DIR/$(sound_for "$1").aiff"
  [ -r "$file" ] || return 0
  afplay "$file" >/dev/null 2>&1 &
}

# Detail text originates from tool/model output, so it must never be able to inject tmux
# format codes. Doubling '#' makes tmux render it literally.
tmux_escape() {
  printf '%s' "${1//#/##}"
}

# True when the user is demonstrably looking at this pane right now: it is the active
# pane, of the active window, in a session whose attached client reports focus. tmux
# exposes "focused" in client_flags because focus-events is on, so this needs no osascript.
watching() {
  local pane="$1" info sess csess cflags
  info="$($TMUX_BIN display-message -p -t "$pane" '#{session_name}|#{pane_active}#{window_active}' 2>/dev/null)" || return 1
  [ "${info##*|}" = "11" ] || return 1
  sess="${info%%|*}"

  while IFS='|' read -r csess cflags; do
    [ "$csess" = "$sess" ] || continue
    case "$cflags" in
      *focused*) return 0 ;;
    esac
  done < <($TMUX_BIN list-clients -F '#{client_session}|#{client_flags}' 2>/dev/null)

  return 1
}

# Render as one connected Catppuccin status module, matching the session and
# calendar widgets. The robot icon identifies the source; textual,
# severity-coloured counts make the current state readable at a glance.
build_alert() {
  local nwait="$1" nerr="$2" ndone="$3" out=""
  local text_bg='#{@thm_surface_0}'

  [ "$nwait" -gt 0 ] && out="$out#[fg=$(colour_for waiting),bg=$text_bg] waiting $nwait"
  [ "$nerr" -gt 0 ] && out="$out#[fg=$(colour_for error),bg=$text_bg] error $nerr"
  [ "$ndone" -gt 0 ] && out="$out#[fg=$(colour_for 'done'),bg=$text_bg] done $ndone"

  if [ -n "$out" ]; then
    out="#[fg=#{@thm_mauve}]#[bg=default]#[fg=#{@thm_crust},bg=#{@thm_mauve}]󰚩 #[fg=#{@thm_fg},bg=$text_bg]$out#[fg=$text_bg] "
  fi
  printf '%s' "$out"
}

# Rebuild every derived display option from pane state, dropping flags for panes where
# opencode has since exited so dead sessions self-heal.
refresh() {
  local pane st win cmd flagged="" nwait=0 nerr=0 ndone=0

  while IFS='|' read -r pane st win cmd; do
    [ -n "${pane:-}" ] || continue
    [ -n "${st:-}" ] || continue

    if [ "$cmd" != "opencode" ]; then
      $TMUX_BIN set-option -pu -t "$pane" "$OPT" 2>/dev/null
      continue
    fi

    flagged="$flagged$win|$st
"
    case "$st" in
      waiting) nwait=$((nwait + 1)) ;;
      error) nerr=$((nerr + 1)) ;;
      done) ndone=$((ndone + 1)) ;;
    esac
  done < <($TMUX_BIN list-panes -a -F "#{pane_id}|#{${OPT}}|#{window_id}|#{pane_current_command}" 2>/dev/null)

  # per-window marker: highest severity among that window's flagged panes
  local cur want wr r lw lst
  while IFS='|' read -r win cur; do
    [ -n "${win:-}" ] || continue
    want=""
    wr=0
    while IFS='|' read -r lw lst; do
      [ "${lw:-}" = "$win" ] || continue
      r="$(rank_for "$lst")"
      if [ "$r" -gt "$wr" ]; then
        wr="$r"
        want="$lst"
      fi
    done <<< "$flagged"

    [ "$want" = "${cur:-}" ] && continue
    if [ -n "$want" ]; then
      $TMUX_BIN set-option -w -t "$win" "$WOPT" "$want" 2>/dev/null
    else
      $TMUX_BIN set-option -wu -t "$win" "$WOPT" 2>/dev/null
    fi
  done < <($TMUX_BIN list-windows -a -F "#{window_id}|#{${WOPT}}" 2>/dev/null)

  $TMUX_BIN set-option -g "$ALERT_OPT" "$(build_alert "$nwait" "$nerr" "$ndone")" 2>/dev/null
}

# The in-tmux equivalent of a banner: a transient message on every attached client, so it
# reaches the user whichever session they are currently viewing. This briefly overwrites
# the status line rather than adding to it, so it also costs no layout.
toast() {
  local state="$1" loc="$2" label="$3" detail="$4" colour msg client
  colour="$(colour_for "$state")"
  msg="#[fg=$colour,bold]$(icon_for "$state") opencode#[nobold] $(tmux_escape "$loc")"
  msg="$msg#[fg=#{@thm_overlay_0}] · $(tmux_escape "$label")"
  [ -n "$detail" ] && msg="$msg #[fg=#{@thm_fg}]$(tmux_escape "$detail")"

  while read -r client; do
    [ -n "${client:-}" ] || continue
    $TMUX_BIN display-message -c "$client" "$msg" 2>/dev/null
  done < <($TMUX_BIN list-clients -F '#{client_name}' 2>/dev/null)
}

announce() {
  local pane="$1" state="$2" label="$3" detail="$4" loc
  loc="$($TMUX_BIN display-message -p -t "$pane" '#{session_name}:#{window_index}' 2>/dev/null)" || loc="$pane"

  play "$state"

  # A finished turn stays quiet visually: the badge is reminder enough, and toasting every
  # completion would interrupt constantly with several agents running.
  [ "$state" = "done" ] && return 0
  toast "$state" "$loc" "$label" "$detail"
}

cmd_set() {
  local pane="${1:-}" state="${2:-}" label="${3:-opencode}" detail="${4:-}" cur
  [ -n "$pane" ] || die "set: pane required"
  case "$state" in
    waiting | done | error) ;;
    *) die "set: state must be waiting|done|error" ;;
  esac

  # Pane vanished between the event and now. display-message exits 0 for an unknown
  # target and just prints nothing, so test the output rather than the status.
  [ -n "$($TMUX_BIN display-message -p -t "$pane" '#{pane_id}' 2>/dev/null)" ] || exit 0

  # Already being watched, so there is nothing to draw attention to.
  if watching "$pane"; then
    cmd_clear "$pane"
    return 0
  fi

  # Dedupe against real tmux state rather than anything remembered by the caller. If the
  # flag was cleared out of band (the user visited the pane), a repeat alert is correct
  # and must not be swallowed.
  cur="$($TMUX_BIN show-options -pqv -t "$pane" "$OPT" 2>/dev/null)" || cur=""
  [ "${cur:-}" = "$state" ] && return 0

  $TMUX_BIN set-option -p -t "$pane" "$OPT" "$state" 2>/dev/null || exit 0
  refresh
  announce "$pane" "$state" "$label" "$detail"
}

cmd_clear() {
  local pane="${1:-}" cur
  [ -n "$pane" ] || die "clear: pane required"

  # Fast path: pane-focus-in fires on every pane switch, so skip the rescan when this
  # pane carries no flag.
  cur="$($TMUX_BIN show-options -pqv -t "$pane" "$OPT" 2>/dev/null)" || cur=""
  [ -n "${cur:-}" ] || return 0

  $TMUX_BIN set-option -pu -t "$pane" "$OPT" 2>/dev/null
  refresh
}

cmd_jump_to() {
  local pane="${1:-}" info sess win client
  [ -n "$pane" ] || die "jump-to: pane required"

  info="$($TMUX_BIN display-message -p -t "$pane" '#{session_name}|#{window_id}' 2>/dev/null)"
  [ -n "$info" ] || return 0
  sess="${info%%|*}"
  win="${info##*|}"
  [ -n "$sess" ] && [ -n "$win" ] || return 0

  client="$($TMUX_BIN list-clients -F '#{client_name}' 2>/dev/null | head -1)"
  [ -n "$client" ] && $TMUX_BIN switch-client -c "$client" -t "$sess" 2>/dev/null
  $TMUX_BIN select-window -t "$win" 2>/dev/null
  $TMUX_BIN select-pane -t "$pane" 2>/dev/null

  cmd_clear "$pane"
}

cmd_jump() {
  local want pane st
  # 'done' is quoted so it reads as a word rather than a loop terminator.
  for want in waiting error 'done'; do
    while IFS='|' read -r pane st; do
      [ "${st:-}" = "$want" ] || continue
      cmd_jump_to "$pane"
      return 0
    done < <($TMUX_BIN list-panes -a -F "#{pane_id}|#{${OPT}}" 2>/dev/null)
  done
  $TMUX_BIN display-message "opencode: nothing waiting" 2>/dev/null
}

main() {
  local sub="${1:-}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    set) cmd_set "$@" ;;
    clear) cmd_clear "$@" ;;
    jump) cmd_jump ;;
    jump-to) cmd_jump_to "$@" ;;
    refresh) refresh ;;
    *)
      printf 'usage: oc-notify {set <pane> <state> <label> [detail]|clear <pane>|jump|jump-to <pane>|refresh}\n' >&2
      exit 2
      ;;
  esac
}

main "$@"
