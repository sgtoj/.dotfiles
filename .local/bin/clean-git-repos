#!/usr/bin/env bash

# -------------------------------------------------------------- description ---

# a script to find and clean git repositories by removing untracked files,
# pruning stale branches, and running garbage collection
#
# usage:
#   clean-git-repos        preview what would be removed
#   clean-git-repos -f     remove it, prune, and gc

# ------------------------------------------------------------ configuration ---

REPO_BASE="$HOME/repos"

KEEP_PATTERNS=(
  .worktrees
  .local
  .secrets
  .env
  ".env.*"
)

# ---------------------------------------------------------------------- fns ---

log() {
  echo -e "\033[1;32m[I] $1\033[0m"
}

log_error() {
  echo -e "\033[1;31m[E] $1\033[0m" >&2
}

clean_git_repo() {
  local repo_path="$1" force="$2"
  local -a excludes=()
  local pattern
  for pattern in "${KEEP_PATTERNS[@]}"; do
    excludes+=(-e "$pattern")
  done

  if [[ $force != 1 ]]; then
    log "would clean: $repo_path"
    git -C "$repo_path" clean -ndx "${excludes[@]}"
    return
  fi

  log "cleaning repository: $repo_path"

  git -C "$repo_path" fetch --prune || {
    log_error "failed to fetch and prune in $repo_path"
    return
  }

  git -C "$repo_path" clean -fdx "${excludes[@]}" || {
    log_error "failed to clean untracked files in $repo_path"
    return
  }

  git -C "$repo_path" gc --aggressive --prune=now || {
    log_error "failed to run git gc in $repo_path"
    return
  }

  log "completed cleaning: $repo_path"
}

# ------------------------------------------------------------------- script ---

force=0
case "${1:-}" in
  -f | --force) force=1 ;;
  "") ;;
  *)
    echo "usage: $(basename "$0") [-f|--force]" >&2
    exit 1
    ;;
esac

# iterate over repositories 2 (+1 for .git directory) levels deep
while read -r git_dir; do
  clean_git_repo "$(dirname "$git_dir")" "$force"
done < <(find "$REPO_BASE" -mindepth 3 -maxdepth 3 -type d -name ".git")

if [[ $force == 1 ]]; then
  log "all repositories cleaned!"
else
  log "dry run only; rerun with -f to clean"
fi
