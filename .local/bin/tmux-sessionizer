#!/usr/bin/env bash

# -------------------------------------------------------------- description ---

# script to select a project directory interactively and then opens or switches
# to a corresponding tmux session for project directory
#
# picker layout:
# - existing tmux sessions first (prefixed with ●), excluding the current one
# - project directories after, sorted by recency (git activity, then dir mtime)
#
# credit:
# - script is based on a script written by primeagen
# - https://github.com/ThePrimeagen/.dotfiles/blob/master/bin/.local/scripts/tmux-sessionizer

# ------------------------------------------------------------ configuration ---

SESSION_PREFIX="● "

function list_search_directories() {
  find ~/repos/mpz ~/repos/cs ~/repos/sgtoj ~/repos/pp ~/repos/scrap ~/repos/gh \
    -mindepth 1 -maxdepth 1 -type d ! -name .worktrees 2>/dev/null
  # git worktrees created by `wt` live inside repos at .worktrees/<branch>;
  # the extra ! -path excludes children of org-level .worktrees dirs
  find ~/repos/mpz ~/repos/cs ~/repos/sgtoj ~/repos/pp ~/repos/scrap ~/repos/gh \
    -mindepth 3 -maxdepth 3 -type d \
    -path '*/.worktrees/*' ! -path '*/.worktrees/*/*' 2>/dev/null
  echo "$HOME/.dotfiles"
}

# ---------------------------------------------------------------------- fns ---

function get_fzf_path() {
  local fzf_path
  fzf_path=$(which fzf || true)
  if [ -d "${HOME}/repos/gh/fzf/bin/" ]; then
    fzf_path="${HOME}/repos/gh/fzf/bin/fzf"
  fi
  if [ ! -f "${fzf_path}" ]; then
    echo "ERROR: fzf not found"
    exit 0
  fi
  echo "${fzf_path}"
}

function exec_fzf() {
  local fzf_path
  fzf_path=$(get_fzf_path)

  $fzf_path \
    --tmux center,90%,80% \
    --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
    --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
    --color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8 \
    --color=selected-bg:#45475a \
    --border="rounded" \
    --preview-window="right,55%,border-left" \
    --preview="$0 --preview {}"
}

# kill sessions whose working directory no longer exists (e.g. a worktree
# removed outside of `wt rm`, such as via lazygit)
function reap_dead_sessions() {
  local current="" name path
  if [[ -n $TMUX ]]; then
    current=$(tmux display-message -p '#S' 2>/dev/null)
  fi
  while IFS=$'\t' read -r name path; do
    if [[ $name != "$current" && -n $path && ! -d $path ]]; then
      tmux kill-session -t "$name" 2>/dev/null
    fi
  done < <(tmux list-sessions -F $'#{session_name}\t#{session_path}' 2>/dev/null)
}

# list existing sessions (excluding the attached one), most recently used first
function list_sessions() {
  local current=""
  if [[ -n $TMUX ]]; then
    current=$(tmux display-message -p '#S' 2>/dev/null)
  fi
  tmux list-sessions -F '#{session_last_attached} #{session_name}' 2>/dev/null |
    sort -rn |
    awk -v cur="$current" -v pfx="$SESSION_PREFIX" \
      '$2 != cur { print pfx $2 }'
}

# list project dirs sorted by recency: newest git activity (FETCH_HEAD/HEAD
# mtime) or dir mtime as fallback
function list_directories_by_recency() {
  local dir ts candidates
  while IFS= read -r dir; do
    ts=""
    if [[ $dir == */.worktrees/* ]]; then
      # worktrees have a .git file; activity lives in the parent repo's
      # .git/worktrees/<name>/ metadata
      candidates=("${dir%/.worktrees/*}/.git/worktrees/$(basename "$dir")/HEAD")
    else
      candidates=("$dir/.git/FETCH_HEAD" "$dir/.git/HEAD")
    fi
    for f in "${candidates[@]}"; do
      if [[ -f $f ]]; then
        ts=$(stat -f '%m' "$f" 2>/dev/null || stat -c '%Y' "$f" 2>/dev/null)
        break
      fi
    done
    if [[ -z $ts ]]; then
      ts=$(stat -f '%m' "$dir" 2>/dev/null || stat -c '%Y' "$dir" 2>/dev/null)
    fi
    printf '%s %s\n' "${ts:-0}" "$dir"
  done < <(list_search_directories) | sort -rn | cut -d' ' -f2-
}

# render the fzf preview for a picker entry (session or directory)
function render_preview() {
  local entry="$1"

  if [[ "$entry" == "$SESSION_PREFIX"* ]]; then
    local session="${entry#"$SESSION_PREFIX"}"
    echo "tmux session: $session"
    echo
    tmux list-windows -t "$session" \
      -F '#I: #W#{?window_active, (active),}' 2>/dev/null
    return
  fi

  if [[ ! -d $entry ]]; then
    return
  fi

  if [[ -e "$entry/.git" ]]; then
    local branch dirty
    branch=$(git -C "$entry" branch --show-current 2>/dev/null)
    dirty=$(git -C "$entry" status --porcelain 2>/dev/null | head -1)
    echo "branch: ${branch:-detached}${dirty:+ (dirty)}"
    echo
    git -C "$entry" log --oneline --no-decorate -5 2>/dev/null
    echo
  fi

  local readme
  for readme in "$entry/README.md" "$entry/readme.md" "$entry/README"; do
    if [[ -f $readme ]]; then
      if command -v bat &>/dev/null; then
        bat --style=plain --color=always --line-range :40 "$readme" 2>/dev/null
      else
        head -40 "$readme"
      fi
      return
    fi
  done

  if ! [[ -e "$entry/.git" ]]; then
    ls -1 "$entry" | head -40
  fi
}

create_session() {
  local name="$1" dir="$2"

  tmux new-session -ds "$name" -c "$dir" "zsh"
  tmux send-keys -t "$name" "nvim-pde" C-m
}

# ------------------------------------------------------------------- script ---

# internal: fzf preview callback
if [[ "$1" == "--preview" ]]; then
  render_preview "$2"
  exit 0
fi

if [[ $# -eq 1 ]]; then
  selected=$1
else
  reap_dead_sessions
  selected=$(
    {
      list_sessions
      list_directories_by_recency
    } | exec_fzf
  )
fi

if [[ -z $selected ]]; then
  exit 0
fi

# existing session selected: switch/attach directly
if [[ "$selected" == "$SESSION_PREFIX"* ]]; then
  session="${selected#"$SESSION_PREFIX"}"
  if [[ -z $TMUX ]]; then
    tmux attach-session -t "$session"
  else
    tmux switch-client -t "$session"
  fi
  exit 0
fi

# generate session name
parent_name=$(basename "$(dirname "$selected")")
base_name=$(basename "$selected" | tr . _)
selected_name="${parent_name}-${base_name}"

# worktree paths (<org>/<repo>/.worktrees/<branch>) name as org-repo-branch
if [[ "$selected" == */.worktrees/* ]]; then
  main_repo="${selected%/.worktrees/*}"
  org_name=$(basename "$(dirname "$main_repo")")
  repo_name=$(basename "$main_repo" | tr . _)
  selected_name="${org_name}-${repo_name}-${base_name}"
fi

# overrides for generated session names
if [[ "$base_name" == "_dotfiles" ]]; then
  selected_name="dotfiles"
elif [[ "$selected" == */.worktrees/* && $(basename "${selected%/.worktrees/*}") == ".dotfiles" ]]; then
  selected_name="dotfiles-${base_name}"
elif [[ "$base_name" == "_github" ]]; then
  selected_name="${parent_name}-github"
fi

tmux_running=$(pgrep tmux)

if [[ -z $TMUX && -z $tmux_running ]]; then
  create_session "$selected_name" "$selected"
  tmux attach-session -t "$selected_name"
  exit 0
fi

# inside tmux or server already running
if ! tmux has-session -t="$selected_name" 2>/dev/null; then
  create_session "$selected_name" "$selected"
fi

tmux switch-client -t "$selected_name"
